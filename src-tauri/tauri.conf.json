{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PartiturMaker",
  "version": "2.0.0",
  "identifier": "id.partiturmaker.editor",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": "node scripts/build-wasm.mjs",
    "beforeDevCommand": "node scripts/build-wasm.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "PartiturMaker",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "PartiturMaker",
    "shortDescription": "Tulis not angka langsung di partitur",
    "longDescription": "Pembuat partitur not angka gaya Kidung Jemaat, PKJ dan NKB, dengan bahasa Nada.",
    "category": "Music",
    "copyright": "MIT",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [
      { "ext": ["nada"], "name": "Partitur Nada", "description": "Partitur not angka PartiturMaker", "role": "Editor" }
    ],
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["English"] }
    }
  }
}
