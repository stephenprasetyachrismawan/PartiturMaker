bait 1 {
  Mu-li-a-kan na-ma-Nya, ha-i u-mat se-mu-a!
  Ka-sih-Nya t'lah me-nya-ta, ter-pan-car di du-ni-a.
}

bait 2 {
  Na-nyi-kan la-gu ba-ru de-ngan se-ge-nap ha-ti;
  Tu-han Al-lah Pe-no-long ki-ni dan se-la-ma-nya.
}

teks 3 {
  Bersama s'gala ciptaan, kita bersorak sorai;
  nama-Nya terpujilah, kini dan selamanya.
}
